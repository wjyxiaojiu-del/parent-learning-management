/* 全局样式 */
page {
  min-height: 100%;
  background: linear-gradient(180deg, #fdfbf7 0%, #fef7ed 100%);
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, input, textarea, button, picker {
  box-sizing: border-box;
}

.page {
  padding: 32rpx 28rpx 48rpx;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 英雄区 */
.hero {
  padding: 36rpx;
  border: 1rpx solid rgba(255, 226, 194, 0.6);
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 249, 240, 0.95) 100%);
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.08);
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 159, 28, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.eyebrow {
  color: #ff9f1c;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #101828;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 数据格 */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 28rpx;
  border: 1rpx solid rgba(255, 226, 194, 0.4);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 252, 247, 0.9) 100%);
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.04);
  transition: all 0.3s ease;
}

.metric:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.metric-label {
  display: block;
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 600;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  color: #101828;
  font-size: 44rpx;
  font-weight: 900;
  font-feature-settings: "tnum";
}

/* 卡片 */
.card {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 226, 194, 0.4);
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 252, 247, 0.95) 100%);
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.06);
  animation: slideUp 0.4s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.card-title {
  display: block;
  margin-bottom: 24rpx;
  color: #101828;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 240, 222, 0.6);
  transition: background 0.2s ease;
}

.row:first-of-type {
  border-top: 0;
}

.row:active {
  background: rgba(255, 249, 240, 0.5);
  border-radius: 12rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.row-sub {
  display: block;
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.5;
}

.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #eef7fd 0%, #e8f4ff 100%);
  color: #4b95cc;
  font-size: 22rpx;
  font-weight: 700;
}

/* 按钮 */
.button {
  min-height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ff9f1c 0%, #ffb347 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 28, 0.3);
  transition: all 0.2s ease;
}

.button:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(255, 159, 28, 0.4);
}

.button-light {
  min-height: 72rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 226, 194, 0.8);
  background: linear-gradient(135deg, #fff7ed 0%, #fff3e0 100%);
  color: #ff9f1c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
  transition: all 0.2s ease;
}

.button-light:active {
  transform: scale(0.96);
  background: linear-gradient(135deg, #ffecd2 0%, #ffe4c4 100%);
}

.close-button {
  width: 100%;
  margin-bottom: 20rpx;
}

/* 表单 */
.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  color: #475569;
  font-size: 24rpx;
  font-weight: 700;
}

.input, .textarea, .picker {
  width: 100%;
  min-height: 80rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(255, 226, 194, 0.6);
  border-radius: 20rpx;
  background: #ffffff;
  color: #172033;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.input:focus, .textarea:focus {
  border-color: #ff9f1c;
  box-shadow: 0 0 0 4rpx rgba(255, 159, 28, 0.1);
}

.textarea {
  min-height: 120rpx;
}

/* 预设标签 */
.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preset-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  color: #475569;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.preset-chip:active {
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
  transform: scale(0.96);
}

/* 空状态 */
.empty {
  padding: 48rpx 0;
  color: #94a3b8;
  text-align: center;
  font-size: 26rpx;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
  animation: bounce 2s ease infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* 提示行 */
.hint-line {
  display: block;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 删除按钮 */
.del-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fef2f2;
  color: #ef4444;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.del-btn:active {
  transform: scale(0.9);
  background: #fee2e2;
}

/* 选择器增强 */
picker {
  position: relative;
}

picker::after {
  content: '▾';
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  font-size: 20rpx;
  pointer-events: none;
}
