<view class="page" wx:if="{{!_loading}}">
  <view class="hero">
    <text class="eyebrow">GROWTH</text>
    <text class="title">身高体重</text>
  </view>

  <!-- 当前数据 -->
  <view class="growth-card" wx:if="{{latest}}">
    <view class="growth-item">
      <text class="growth-label">身高</text>
      <text class="growth-value">{{latest.heightCm}}<text class="growth-unit">cm</text></text>
    </view>
    <view class="growth-item">
      <text class="growth-label">体重</text>
      <text class="growth-value">{{latest.weightKg}}<text class="growth-unit">kg</text></text>
    </view>
  </view>

  <!-- 记录表单 -->
  <view class="card">
    <text class="card-title">记录数据</text>
    <view class="form">
      <view class="field">
        <text class="label">身高 cm</text>
        <input class="input" type="digit" value="{{form.heightCm}}" bindinput="onHeightInput" placeholder="例如 151" />
      </view>
      <view class="field">
        <text class="label">体重 kg</text>
        <input class="input" type="digit" value="{{form.weightKg}}" bindinput="onWeightInput" placeholder="例如 42" />
      </view>
      <button class="button" bindtap="saveRecord">记录</button>
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="card" wx:if="{{records.length > 0}}">
    <text class="card-title">历史记录</text>
    <view wx:for="{{records}}" wx:key="id" class="row">
      <view class="row-main">
        <text class="row-title">{{item.date}}</text>
        <text class="row-sub">{{item.heightCm}}cm · {{item.weightKg}}kg</text>
      </view>
      <text class="del-btn" data-id="{{item.id}}" catchtap="deleteRecord">×</text>
    </view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty">
    <text class="empty-icon">📏</text>
    <text>还没有记录</text>
  </view>
</view>
