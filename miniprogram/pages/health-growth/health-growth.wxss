/* 身高体重页 */

.growth-card {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.growth-item {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fffcf7 100%);
  border: 1rpx solid rgba(255, 226, 194, 0.4);
  text-align: center;
}

.growth-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.growth-value {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #172033;
  font-feature-settings: "tnum";
}

.growth-unit {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
}

.trend-badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 12rpx;
}

.trend-up {
  background: #dcfce7;
  color: #16a34a;
}

.trend-down {
  background: #fef2f2;
  color: #ef4444;
}

.trend-same {
  background: #f1f5f9;
  color: #64748b;
}

/* 图表容器 */
.chart-container {
  padding: 16rpx 0;
}

.chart-legend {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-bottom: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 22rpx;
  color: #64748b;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 8rpx;
}

.chart-bar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.chart-bar-wrapper {
  display: flex;
  gap: 4rpx;
  align-items: flex-end;
  height: 160rpx;
  width: 100%;
}

.chart-bar {
  flex: 1;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 8rpx;
  transition: height 0.5s ease;
}

.height-bar {
  background: linear-gradient(180deg, #ff9f1c 0%, #ffb347 100%);
}

.weight-bar {
  background: linear-gradient(180deg, #4b95cc 0%, #6bb3e0 100%);
}

.chart-label {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
