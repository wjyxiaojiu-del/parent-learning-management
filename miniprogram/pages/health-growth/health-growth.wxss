/* 身高体重页 */

.growth-card {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.growth-item {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fffcf7 100%);
  border: 1rpx solid rgba(255, 226, 194, 0.4);
  text-align: center;
}

.growth-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.growth-value {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #172033;
  font-feature-settings: "tnum";
}

.growth-unit {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
}

.trend-badge {
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.trend-up {
  background: #dcfce7;
  color: #16a34a;
}

.trend-down {
  background: #fef2f2;
  color: #ef4444;
}

.trend-same {
  background: #f1f5f9;
  color: #64748b;
}

.chart-placeholder {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
