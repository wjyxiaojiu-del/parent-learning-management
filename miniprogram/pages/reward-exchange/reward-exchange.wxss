/* 奖励兑换页 */

.points-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
}

.points-icon {
  font-size: 40rpx;
}

.points-value {
  font-size: 56rpx;
  font-weight: 900;
  color: #ff9f1c;
  font-feature-settings: "tnum";
}

.points-label {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
}

.reward-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 240, 222, 0.6);
}

.reward-item:last-child {
  border-bottom: none;
}

.reward-icon {
  font-size: 36rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-radius: 16rpx;
}

.reward-content {
  flex: 1;
  min-width: 0;
}

.reward-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
}

.reward-cost {
  display: block;
  font-size: 22rpx;
  color: #ff9f1c;
  font-weight: 700;
  margin-top: 4rpx;
}

.reward-btn {
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.reward-btn.can-redeem {
  background: linear-gradient(135deg, #ff9f1c 0%, #ffb347 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255, 159, 28, 0.3);
}

.reward-btn.can-redeem:active {
  transform: scale(0.95);
}

.reward-btn.cannot-redeem {
  background: #f1f5f9;
  color: #94a3b8;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.6);
}

.history-item:last-child {
  border-bottom: none;
}

.history-icon {
  font-size: 28rpx;
}

.history-content {
  flex: 1;
  min-width: 0;
}

.history-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #172033;
}

.history-time {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

.history-points {
  font-size: 24rpx;
  font-weight: 700;
  color: #ef4444;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
