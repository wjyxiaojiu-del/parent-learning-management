/* 课程管理页 */

.weekday-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.weekday-tab {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  transition: all 0.2s ease;
}

.weekday-tab.active {
  background: linear-gradient(135deg, #ff9f1c 0%, #ffb347 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 159, 28, 0.3);
}

.weekday-tab:active {
  transform: scale(0.95);
}

.course-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 240, 222, 0.6);
}

.course-item:last-child {
  border-bottom: none;
}

.course-time {
  flex-shrink: 0;
  width: 120rpx;
  text-align: center;
}

.course-start {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
  font-feature-settings: "tnum";
}

.course-end {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.course-divider {
  width: 4rpx;
  height: 48rpx;
  background: linear-gradient(180deg, #ff9f1c 0%, #ffb347 100%);
  border-radius: 2rpx;
}

.course-content {
  flex: 1;
  min-width: 0;
}

.course-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
}

.course-subject {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
