/* 运动打卡页 */

.sport-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sport-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.sport-item.active {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-color: #ff9f1c;
  box-shadow: 0 4rpx 16rpx rgba(255, 159, 28, 0.2);
}

.sport-item:active {
  transform: scale(0.95);
}

.sport-icon {
  font-size: 36rpx;
}

.sport-name {
  font-size: 22rpx;
  color: #475569;
  font-weight: 600;
}

.sport-item.active .sport-name {
  color: #ff9f1c;
}

.duration-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.duration-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  font-size: 32rpx;
  color: #475569;
  font-weight: 700;
  transition: all 0.2s ease;
}

.duration-btn:active {
  transform: scale(0.92);
  background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
}

.duration-value {
  flex: 1;
  text-align: center;
  font-size: 48rpx;
  font-weight: 900;
  color: #172033;
  font-feature-settings: "tnum";
}

.duration-unit {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
}

.points-preview {
  text-align: center;
  padding: 16rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  font-size: 26rpx;
  color: #ff9f1c;
  font-weight: 700;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
