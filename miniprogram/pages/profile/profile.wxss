/* 个人页 */

.hero {
  position: relative;
  overflow: hidden;
}

.hero-content {
  position: relative;
  z-index: 1;
}

/* 本周进度 */
.progress-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 249, 240, 0.95) 100%);
  border: 1rpx solid rgba(255, 226, 194, 0.4);
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.04);
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #172033;
}

.progress-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #ff9f1c;
}

.progress-bar {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff9f1c 0%, #ffb347 100%);
  border-radius: 6rpx;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 数据统计 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-item {
  text-align: center;
  padding: 24rpx 16rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.stat-item:active {
  transform: scale(0.95);
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #172033;
  font-feature-settings: "tnum";
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 健康数据预览 */
.health-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx 0;
}

.health-item {
  text-align: center;
}

.health-value {
  font-size: 44rpx;
  font-weight: 900;
  color: #172033;
}

.health-unit {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 600;
}

.health-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.health-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e2e8f0;
}

/* 成就徽章 */
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.achievement-item {
  padding: 24rpx;
  border-radius: 20rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.achievement-item.unlocked {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 2rpx solid rgba(255, 159, 28, 0.3);
}

.achievement-item.locked {
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border: 2rpx solid #e2e8f0;
  opacity: 0.7;
}

.achievement-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.achievement-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #172033;
  margin-bottom: 4rpx;
}

.achievement-desc {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
}

.achievement-progress {
  margin-top: 12rpx;
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.achievement-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #ff9f1c 0%, #ffb347 100%);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

/* 功能入口 */
.entry-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 240, 222, 0.6);
  transition: all 0.2s ease;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-item:active {
  background: rgba(255, 249, 240, 0.5);
  margin: 0 -16rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 16rpx;
}

.entry-icon {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff9f0 0%, #fff3e0 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 226, 194, 0.4);
}

.entry-content {
  flex: 1;
  min-width: 0;
}

.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #172033;
}

.entry-desc {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.entry-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}

/* 关于 */
.about-card {
  text-align: center;
  padding: 40rpx 32rpx;
}

.about-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #172033;
}

.about-version {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.about-desc {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 12rpx;
}
