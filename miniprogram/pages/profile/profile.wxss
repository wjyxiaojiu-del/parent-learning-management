/* 个人页 */

.entry-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  transition: all 0.2s ease;
}

.entry-item:active {
  opacity: 0.7;
}

.entry-icon {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff9f0 0%, #fff3e0 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 226, 194, 0.4);
}

.entry-content {
  flex: 1;
  min-width: 0;
}

.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #172033;
}

.entry-desc {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.entry-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}
