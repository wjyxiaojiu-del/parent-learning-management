<view class="page" wx:if="{{!_loading}}">
  <view class="hero">
    <text class="eyebrow">SETTINGS</text>
    <text class="title">设置</text>
  </view>

  <view class="card">
    <text class="card-title">孩子信息</text>
    <view class="form">
      <view class="field">
        <text class="label">姓名</text>
        <input class="input" data-key="childName" value="{{childName}}" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">年龄</text>
        <input class="input" type="number" data-key="age" value="{{age}}" bindinput="onInput" />
      </view>
      <button class="button" bindtap="saveSettings">保存</button>
    </view>
  </view>

  <view class="card">
    <text class="card-title">科目</text>
    <view class="subject-tags">
      <view wx:for="{{subjects}}" wx:key="*this" class="subject-tag">
        <text>{{item}}</text>
        <text class="tag-x" data-name="{{item}}" catchtap="removeSubject">×</text>
      </view>
    </view>
    <view class="add-row">
      <input class="input" value="{{newSubject}}" bindinput="onNewSubjectInput" placeholder="新科目" bindconfirm="addSubject" />
      <button class="button" size="mini" bindtap="addSubject">添加</button>
    </view>
  </view>

  <!-- 数据同步 -->
  <view class="card">
    <view class="card-header">
      <text class="card-title">数据同步</text>
      <view class="sync-status {{syncStatus}}">
        <text>{{syncStatusText}}</text>
      </view>
    </view>
    <button class="button" bindtap="syncToCloud">同步到云端</button>
    <text class="hint-text">开启云开发后可自动同步数据到云端，多设备共享</text>
  </view>

  <!-- 数据管理 -->
  <view class="card">
    <view class="card-header" bindtap="toggleDataPanel">
      <text class="card-title">数据管理</text>
      <text class="toggle-icon">{{showDataPanel ? '▲' : '▼'}}</text>
    </view>

    <view wx:if="{{showDataPanel}}" class="data-panel">
      <view class="data-actions">
        <button class="button-light" bindtap="exportToClipboard">导出数据</button>
        <button class="button-light" bindtap="importFromClipboard">导入数据</button>
      </view>
      <text class="hint-text">导出：将数据复制到剪贴板，可粘贴保存</text>
      <text class="hint-text">导入：从剪贴板读取数据（会覆盖当前数据）</text>
      <button class="button reset-btn" bindtap="clearData">清除所有数据</button>
    </view>
  </view>
</view>