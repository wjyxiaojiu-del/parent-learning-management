/* 设置页 */

.subject-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.subject-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 1rpx solid rgba(255, 226, 194, 0.6);
  transition: all 0.2s ease;
}

.subject-tag:active {
  transform: scale(0.95);
}

.tag-x {
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 700;
  padding: 4rpx;
}

.add-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-row .input {
  flex: 1;
}

.reset-btn {
  width: 100%;
  color: #ef4444 !important;
  border-color: rgba(239, 68, 68, 0.3) !important;
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%) !important;
}

.reset-btn:active {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%) !important;
}
