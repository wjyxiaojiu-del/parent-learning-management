/* 设置页 */

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.subject-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.subject-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 1rpx solid rgba(255, 226, 194, 0.6);
  transition: all 0.2s ease;
}

.subject-tag:active {
  transform: scale(0.95);
}

.tag-x {
  font-size: 24rpx;
  color: #ef4444;
  font-weight: 700;
  padding: 4rpx;
}

.add-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.add-row .input {
  flex: 1;
}

/* 同步状态 */
.sync-status {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.sync-status.idle {
  background: #f1f5f9;
  color: #64748b;
}

.sync-status.syncing {
  background: #dbeafe;
  color: #3b82f6;
}

.sync-status.success {
  background: #dcfce7;
  color: #16a34a;
}

.sync-status.error {
  background: #fef2f2;
  color: #ef4444;
}

/* 提示文字 */
.hint-text {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.6;
}

/* 数据面板 */
.data-panel {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 240, 222, 0.6);
}

.data-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.data-actions .button-light {
  flex: 1;
}

.toggle-icon {
  font-size: 24rpx;
  color: #94a3b8;
}

.reset-btn {
  margin-top: 24rpx;
  width: 100%;
  color: #ef4444 !important;
  border-color: rgba(239, 68, 68, 0.3) !important;
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%) !important;
}

.reset-btn:active {
  background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%) !important;
}
