/* 记录页 */

.points-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff9f1c 0%, #ffb347 50%, #ffc96b 100%);
  box-shadow: 0 16rpx 48rpx rgba(255, 159, 28, 0.3);
  position: relative;
  overflow: hidden;
}

.points-card::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.points-card::after {
  content: '';
  position: absolute;
  bottom: -40%;
  left: 10%;
  width: 150rpx;
  height: 150rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.points-main {
  position: relative;
  z-index: 1;
}

.points-num {
  font-size: 64rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  font-feature-settings: "tnum";
  display: block;
}

.points-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.points-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
}

.streak-icon {
  font-size: 28rpx;
}

.streak-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

/* 本周统计 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 16rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #172033;
  font-feature-settings: "tnum";
}

.stat-label {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 功能入口 */
.entry-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 240, 222, 0.6);
  transition: all 0.2s ease;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-item:active {
  background: rgba(255, 249, 240, 0.5);
  margin: 0 -16rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 16rpx;
}

.entry-icon {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff9f0 0%, #fff3e0 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 226, 194, 0.4);
}

.entry-content {
  flex: 1;
  min-width: 0;
}

.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #172033;
}

.entry-desc {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.entry-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.entry-count {
  font-size: 22rpx;
  color: #ff9f1c;
  font-weight: 700;
  background: rgba(255, 159, 28, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.entry-arrow {
  font-size: 28rpx;
  color: #cbd5e1;
  transition: transform 0.2s ease;
}

.entry-item:active .entry-arrow {
  transform: translateX(4rpx);
}

/* 最近动态 */
.activity-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 240, 222, 0.4);
  animation: activitySlide 0.3s ease-out;
}

@keyframes activitySlide {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-icon {
  font-size: 32rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 12rpx;
}

.activity-content {
  flex: 1;
  min-width: 0;
}

.activity-text {
  display: block;
  font-size: 26rpx;
  color: #172033;
  font-weight: 600;
}

.activity-time {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}
